# LOGOS ASF — Environment Configuration
# Copy to .abigail.env and fill in your values
# NEVER commit .abigail.env to version control
#
# cp .abigail.env.example .abigail.env
# then: make up

# ── Model Backend ─────────────────────────────────────────────────────────────
# Options: groq | anthropic | perplexity | ollama
ABIGAIL_BACKEND=groq

# ── API Keys (fill in at least one) ──────────────────────────────────────────
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
# PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY_HERE

# ── Ollama (local model — no API key needed) ──────────────────────────────────
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Mode Tokens (generate strong random values) ──────────────────────────────
# These control PUBLIC/DEMO/ADMIN mode via the Authorization / X-HAAP-Token header.
# Required: at least 43 characters, not a placeholder/template value — validated
# at startup and on every request (abigail/privileged_credentials.py). Copying
# this file unchanged cannot authenticate: both values below are rejected.
# Generate a real value for each (use TWO DIFFERENT values):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ABIGAIL_ADMIN_TOKEN=GENERATE_A_STRONG_RANDOM_TOKEN_HERE
ABIGAIL_DEMO_TOKEN=YOUR_DEMO_TOKEN_HERE

# ── Sentinel OverWatch (set automatically by docker-compose) ──────────────────
# SENTINEL_URL=http://sentinel:8080   ← set by docker-compose, do not change here

# ── Governance Profile ────────────────────────────────────────────────────────
# Options: consumer | medical | finance | defense
SENTOW_INDUSTRY_PROFILE=consumer

# HAAP DRS ceiling — actions above this score require human auth token
# Default 60 = JIT_AUTHORIZATION threshold per LOGOS-PLY-001
SENTOW_HAAP_DRS_CEILING=60
