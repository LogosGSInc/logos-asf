</div><!-- /shell -->

<!-- CHIP STYLE (inline for dynamic chips) -->
<style>
.chip{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-sm);padding:.35rem .7rem;font-size:.7875rem;cursor:pointer;transition:all var(--ease);color:var(--muted)}
.chip:hover{border-color:var(--primary);color:var(--text)}
.chip.on{background:var(--primary-glow);border-color:var(--primary);color:var(--primary);font-weight:600}
</style>

<script>
// ── STATE ──
const S = {
  type: null,
  fork: null,
  delivery: 'gov',
  page: 1
};

// ── TYPE SELECTION ──
function selType(t) {
  S.type = t;
  ['app','ent','agt'].forEach(k => {
    document.getElementById('tc-' + k).classList.toggle('sel', k === t);
  });
  document.getElementById('agent-fork').classList.toggle('show', t === 'agt');
  document.getElementById('app-chips').style.display = t === 'app' ? 'block' : 'none';
  document.getElementById('ent-chips').style.display = t === 'ent' ? 'block' : 'none';
}

// ── FORK ──
function selFork(f) {
  S.fork = f;
  ['single','team'].forEach(k => {
    document.getElementById('fork-' + k).classList.toggle('sel', k === f);
  });
}

// ── DELIVERY ──
function selDelivery(d) {
  S.delivery = d;
  ['gov','firm','ent'].forEach(k => {
    document.getElementById('dc-' + k).classList.toggle('sel', k === d);
  });
}

// ── CHIPS ──
function toggleChip(el) { el.classList.toggle('on'); }
function toggleCI(el) { el.classList.toggle('on'); }

// ── RANGE ──
function setRange(el, outId, labels) {
  const v = parseInt(el.value);
  const pct = (v / (parseInt(el.max))) * 100;
  el.style.setProperty('--p', pct + '%');
  document.getElementById(outId).textContent = labels[v];
}

// ── TOOLTIP ──
function toggleTip(icon) {
  const wasOpen = icon.classList.contains('open');
  document.querySelectorAll('.info-icon.open').forEach(i => i.classList.remove('open'));
  if (!wasOpen) icon.classList.add('open');
}
document.addEventListener('click', (e) => {
  if (!e.target.classList.contains('info-icon')) {
    document.querySelectorAll('.info-icon.open').forEach(i => i.classList.remove('open'));
  }
});

// ── NAVIGATION ──
function goTo(n) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById(n === 'ok' ? 'pg-ok' : 'pg' + n).classList.add('active');
  document.querySelectorAll('.step').forEach((s, i) => {
    s.classList.remove('active', 'done');
    if (typeof n === 'number') {
      if (i + 1 < n) s.classList.add('done');
      if (i + 1 === n) s.classList.add('active');
    } else {
      s.classList.add('done');
    }
  });
  S.page = n;
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ── SIMPLE HASH (FNV-like, no crypto API needed in sandbox) ──
function simpleHash(str) {
  let h = 0x811c9dc5;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = (h * 0x01000193) >>> 0;
  }
  return h.toString(16).toUpperCase().padStart(8, '0');
}

function genJobId(data) {
  const now = new Date();
  const ts = now.getFullYear().toString() +
    String(now.getMonth() + 1).padStart(2, '0') +
    String(now.getDate()).padStart(2, '0');
  const hash = simpleHash(JSON.stringify(data));
  return `LOGOS-${ts}-${hash}`;
}

// ── COLLECT STATE ──
function collectState() {
  const typeMap = { app: 'App / Software', ent: 'Enterprise Software', agt: 'Agent / Workflow' };
  const delivMap = { gov: 'Governed', firm: 'Firm', ent: 'Enterprise' };
  const compls = Array.from(document.querySelectorAll('.compliance-item.on')).map(el =>
    el.querySelector('.ci-name').textContent.replace(/ⓘ/g, '').trim()
  );

  return {
    type: S.type ? typeMap[S.type] : 'Not selected',
    fork: S.type === 'agt' ? (S.fork === 'single' ? 'Single Agent' : S.fork === 'team' ? 'Agent Team' : 'Not selected') : null,
    name: document.getElementById('f-name').value || '',
    problem: document.getElementById('f-problem').value || '',
    success: document.getElementById('f-success').value || '',
    nogo: document.getElementById('f-nogo').value || '',
    sector: document.getElementById('f-sector').value || '',
    stack: document.getElementById('f-stack').value || '',
    complexity: document.getElementById('complexity-val').textContent,
    delivery: delivMap[S.delivery],
    compliance: compls,
    timeline: document.getElementById('timeline-val').textContent,
    budget: document.getElementById('budget-val').textContent,
    engmodel: document.getElementById('f-model').value,
    support: document.getElementById('f-support').value,
    contact: document.getElementById('f-contact').value || '',
    email: document.getElementById('f-email').value || '',
    org: document.getElementById('f-org').value || '',
    contactMethod: document.getElementById('f-contact-method').value,
    notes: document.getElementById('f-notes').value || ''
  };
}

// ── BUILD REVIEW ──
function buildReview() {
  const d = collectState();
  const id = genJobId(d);
  document.getElementById('job-id').textContent = id;
  window._jobId = id;

  const rows = [
    ['Order Type', d.type],
    ...(d.fork ? [['Agent Structure', d.fork]] : []),
    ['Project Name', d.name || '—'],
    ['Industry', d.sector || '—'],
    ['Complexity', d.complexity],
    ['Delivery Scope', d.delivery],
    ['Compliance', d.compliance.length ? d.compliance : ['Logos Baseline']],
    ['Timeline', d.timeline],
    ['Budget', d.budget],
    ['Engagement', d.engmodel],
    ['Post-Delivery', d.support],
    ['Contact', [d.contact, d.email, d.org].filter(Boolean).join(' · ') || '—'],
  ];

  document.getElementById('review-rows').innerHTML = rows.map(([k, v]) => {
    const val = Array.isArray(v)
      ? '<div class="tag-row">' + v.map(x => `<span class="tag">${x}</span>`).join('') + '</div>'
      : `<span>${v}</span>`;
    return `<div class="sr"><span class="sr-k">${k}</span><span class="sr-v">${val}</span></div>`;
  }).join('');
}

// ── SUBMIT ──
function submitOrder() {
  const jobId = window._jobId || 'LOGOS-' + Date.now();
  document.getElementById('confirm-id').textContent = jobId;

  // Collect all form data for API submission
  const payload = {
    job_order_id: jobId,
    scope_hash: window._scopeHash || '',
    order_type: window._sel?.type || '',
    agent_fork: window._sel?.fork || '',
    delivery_tier: window._sel?.delivery || '',
    sector: document.getElementById('f-sector')?.value || '',
    compliance: Array.from(document.querySelectorAll('.comp-chip.sel'))
                     .map(el => el.dataset.val || el.textContent.trim()),
    constraints: document.getElementById('f-constraints')?.value || '',
    problem: document.getElementById('f-problem')?.value || '',
    success: document.getElementById('f-success')?.value || '',
    name: document.getElementById('f-name')?.value || '',
    email: document.getElementById('f-email')?.value || '',
  };

  // POST to Abigail's intake endpoint — non-blocking, show success immediately
  fetch('/api/intake', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
  }).then(r => r.json()).then(data => {
    if (!data.ok) console.warn('Intake API error:', data.error);
  }).catch(e => console.warn('Intake API unreachable:', e));

  goTo('ok');
}

// ── INIT RANGES ──
document.addEventListener('DOMContentLoaded', () => {
  setRange(document.getElementById('complexity-r'), 'complexity-val',
    ['Simple — focused task, 1–2 weeks','Standard — multi-feature, 2–6 weeks','Moderate — integrated system, 1–3 months','Complex — full platform, 3–6 months','Enterprise — firm-level, 6+ months']);
  setRange(document.getElementById('timeline-r'), 'timeline-val',
    ['ASAP — expedite if possible','2 weeks','30 days','60 days','Flexible — no hard deadline']);
  setRange(document.getElementById('budget-r'), 'budget-val',
    ['Under $1,000','$1,000 – $5,000','$5,000 – $15,000','$15,000 – $50,000','$50,000 – $150,000','$150,000 – $500,000','$500,000+']);
});
</script>
</body>
</html>